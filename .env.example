# Names-only inventory of every environment variable the development
# environment requires (D-013, D-016). Every value is deliberately empty.
# Copy to .env (gitignored) and fill in locally. Never commit a real value.

# --- Application ---
CRM_ENVIRONMENT=
CRM_API_BIND_ADDR=
RUST_LOG=

# --- Database (PostgreSQL in local Docker) ---
# DATABASE_URL is the crm_app (application, DML-only) connection.
# MIGRATION_DATABASE_URL is the crm_migrator (schema-owner) connection,
# used only by scripts/db-migrate, scripts/dev-seed, and check-db
# (docs/specs/SLICE_001.md).
DATABASE_URL=
MIGRATION_DATABASE_URL=
CRM_DATABASE_CONNECT_TIMEOUT_MS=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
CRM_DB_APP_PASSWORD=
CRM_DB_MIGRATOR_PASSWORD=

# --- Local development auth (D-016: username/password, no ZITADEL in dev) ---
CRM_SESSION_SECRET=
CRM_SESSION_TTL_HOURS=
CRM_SESSION_COOKIE_SECURE=
CRM_DEV_SEED_PASSWORD=
# Raw lead-payload encryption key (docs/specs/SLICE_002.md §7): exactly 64
# hex characters (32 bytes), e.g. `openssl rand -hex 32`. The API refuses to
# start if missing, the wrong length, or not hex.
CRM_RAW_PAYLOAD_KEY=
# Optional. Invitation expiry in hours, bounds 1-720 (docs/specs/SLICE_004.md
# §11). Default: 168 (7 days)
CRM_INVITATION_TTL_HOURS=
# Only needed when the browser app and API are tunneled on separate
# hostnames (e.g. app.tarams.org calling api.tarams.org directly). Leave
# both unset for loopback dev and for a single-hostname tunnel.
CRM_CORS_ALLOWED_ORIGIN=
CRM_SESSION_COOKIE_DOMAIN=

# --- Web (Vite dev server) ---
CRM_WEB_BIND_ADDR=
CRM_WEB_PORT=
CRM_WEB_API_PROXY_TARGET=
CRM_WEB_ALLOWED_HOSTS=
VITE_API_BASE_URL=

# --- Realtime (Centrifugo in local Docker; docs/specs/SLICE_003.md §11) ---
CENTRIFUGO_HTTP_API_KEY=
# Required, at least 32 bytes (e.g. `openssl rand -hex 32`, which yields 64
# hex characters = 32 bytes). The API refuses to start on a shorter value.
# Regenerate and restart Centrifugo (./scripts/dev-services down && up) if
# an existing value is shorter.
CENTRIFUGO_TOKEN_HMAC_SECRET=
# Optional. Centrifugo's HTTP API base URL, http:// only, no trailing
# slash. Default: http://127.0.0.1:8000/api
CRM_CENTRIFUGO_API_URL=
# Optional. Connection-token lifetime in seconds, bounds 60-3600. Default: 600
CRM_REALTIME_TOKEN_TTL_SECONDS=
# Optional. Vite's WebSocket proxy target for /connection. Default: http://127.0.0.1:8000
CRM_WEB_REALTIME_PROXY_TARGET=
# Optional. scripts/demo-leads' target. Default: http://127.0.0.1:3000
CRM_DEMO_API_URL=

# --- External connectivity (Cloudflare tunnel on tarams.org) ---
# The crm-dev tunnel is locally-managed: its ingress lives in
# infra/development/cloudflared/config.yml, and it authenticates via the
# credentials file cloudflared writes outside the repo at tunnel-creation
# time (~/.cloudflared/<tunnel-id>.json) — no token needed here.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- AI inference (Operator slice) ---
GROQ_API_KEY=

# --- Observability (deferred; console logging for now, D-016) ---
OTEL_SERVICE_NAME=
