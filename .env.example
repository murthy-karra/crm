# Names-only inventory of every environment variable the development
# environment requires (D-013, D-016). Every value is deliberately empty.
# Copy to .env (gitignored) and fill in locally. Never commit a real value.

# --- Application ---
CRM_ENVIRONMENT=
CRM_API_BIND_ADDR=
RUST_LOG=

# --- Database (PostgreSQL in local Docker) ---
# DATABASE_URL is the crm_app (application, DML-only) connection.
# MIGRATION_DATABASE_URL is the crm_migrator (schema-owner) connection,
# used only by scripts/db-migrate, scripts/dev-seed, and check-db
# (docs/specs/SLICE_001.md).
DATABASE_URL=
MIGRATION_DATABASE_URL=
CRM_DATABASE_CONNECT_TIMEOUT_MS=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
CRM_DB_APP_PASSWORD=
CRM_DB_MIGRATOR_PASSWORD=

# --- Local development auth (D-016: username/password, no ZITADEL in dev) ---
CRM_SESSION_SECRET=
CRM_SESSION_TTL_HOURS=
CRM_SESSION_COOKIE_SECURE=
CRM_DEV_SEED_PASSWORD=
# Raw lead-payload encryption key (docs/specs/SLICE_002.md §7): exactly 64
# hex characters (32 bytes), e.g. `openssl rand -hex 32`. The API refuses to
# start if missing, the wrong length, or not hex.
CRM_RAW_PAYLOAD_KEY=
# Optional. Invitation expiry in hours, bounds 1-720 (docs/specs/SLICE_004.md
# §11). Default: 168 (7 days)
CRM_INVITATION_TTL_HOURS=
# Only needed when the browser app and API are tunneled on separate
# hostnames (e.g. app.tarams.org calling api.tarams.org directly). Leave
# both unset for loopback dev and for a single-hostname tunnel.
CRM_CORS_ALLOWED_ORIGIN=
CRM_SESSION_COOKIE_DOMAIN=

# --- Web (Vite dev server) ---
CRM_WEB_BIND_ADDR=
CRM_WEB_PORT=
CRM_WEB_API_PROXY_TARGET=
CRM_WEB_ALLOWED_HOSTS=
VITE_API_BASE_URL=

# --- Realtime (Centrifugo in local Docker; docs/specs/SLICE_003.md §11) ---
CENTRIFUGO_HTTP_API_KEY=
# Required, at least 32 bytes (e.g. `openssl rand -hex 32`, which yields 64
# hex characters = 32 bytes). The API refuses to start on a shorter value.
# Regenerate and restart Centrifugo (./scripts/dev-services down && up) if
# an existing value is shorter.
CENTRIFUGO_TOKEN_HMAC_SECRET=
# Optional. Centrifugo's HTTP API base URL, http:// only, no trailing
# slash. Default: http://127.0.0.1:8000/api
CRM_CENTRIFUGO_API_URL=
# Optional. Connection-token lifetime in seconds, bounds 60-3600. Default: 600
CRM_REALTIME_TOKEN_TTL_SECONDS=
# Optional. Vite's WebSocket proxy target for /connection. Default: http://127.0.0.1:8000
CRM_WEB_REALTIME_PROXY_TARGET=
# Optional. scripts/demo-leads' target. Default: http://127.0.0.1:3000
CRM_DEMO_API_URL=

# --- External connectivity (Cloudflare tunnel on tarams.org) ---
# The crm-dev tunnel is locally-managed: its ingress lives in
# infra/development/cloudflared/config.yml, and it authenticates via the
# credentials file cloudflared writes outside the repo at tunnel-creation
# time (~/.cloudflared/<tunnel-id>.json) — no token needed here.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- AI inference (Operator slice; docs/specs/SLICE_005.md §11) ---
# Empty or unset disables the Operator (POST /api/operator/turns answers
# 503 operator_disabled); everything else keeps working. The bounds below
# are validated at startup even without a key.
GROQ_API_KEY=
CRM_OPERATOR_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint; https:// (http:// only for loopback); no trailing slash
CRM_OPERATOR_MODEL=openai/gpt-oss-120b
CRM_OPERATOR_TURN_TIMEOUT_MS=20000      # bounds 2000–60000
CRM_OPERATOR_CALL_TIMEOUT_MS=10000      # bounds 1000–30000, must be ≤ turn timeout
CRM_OPERATOR_MAX_CONCURRENT=4           # bounds 1–64
CRM_OPERATOR_PROPOSAL_TTL_SECONDS=120   # start_call proposal lifetime; bounds 30–600

# --- Email intake (docs/specs/SLICE_007a.md) ---------------------------
# The domain Organization intake addresses are rendered on (bare hostname)
# and the rendered form: subdomain = leads-<token>@<slug>.<domain>,
# local_part = <slug>-<token>@leads.<domain>. Storage is scheme-neutral.
CRM_INTAKE_MAIL_DOMAIN=elysianfeld.com
CRM_INTAKE_ADDRESS_SCHEME=subdomain

# --- Inbound email endpoint (docs/specs/SLICE_007b.md §6) ---------------
# Bearer credential for POST /inbound/email (a dev script stand-in for real
# receiving until 007g). Empty/unset = endpoint disabled (401 on every
# request), not a startup error; at least 32 bytes when set.
CRM_INBOUND_EMAIL_SECRET=

# --- Telephony (Slice 006; docs/specs/SLICE_006.md §11) ---
# LIVEKIT_API_KEY empty/unset = calling disabled (503 telephony_disabled),
# not a startup error; the CRM_TELEPHONY_* bounds and the URLs are
# validated regardless. The LIVEKIT_API_KEY/SECRET pair must match the
# telephony host's livekit.yaml (README: "Telephony host") — a manual sync.
LIVEKIT_URL=                         # wss://livekit.tarams.org (browser signaling; Caddy → LiveKit)
LIVEKIT_API_URL=                     # https://livekit.tarams.org (API; http:// only for loopback; never Cloudflare-proxied)
LIVEKIT_API_KEY=                     # empty/unset = calling disabled
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
CRM_TELEPHONY_RING_TIMEOUT_SECONDS=45      # bounds 10–120
CRM_TEST_LIVEKIT_API_URL=                  # scripts/check-telephony only; never read by check-db
CRM_TELEPHONY_MAX_CALL_SECONDS=3600        # bounds 60–14400
CRM_TELEPHONY_JOIN_TTL_SECONDS=300         # bounds 60–900
TELNYX_SIP_USERNAME=                 # scripts/telephony-trunk only
TELNYX_SIP_PASSWORD=
TELNYX_NUMBER_E164=

# --- Observability (deferred; console logging for now, D-016) ---
OTEL_SERVICE_NAME=

# --- Slice 007f: LLM lead extraction (docs/specs/SLICE_007f.md §5) ---
# Worker poll interval in seconds (default 10, bounds 1-300).
CRM_EXTRACTION_POLL_SECONDS=
# Extraction model (default: the Operator default model).
CRM_EXTRACTION_MODEL=
# Per-LLM-call budget in ms (default 15000, bounds 1000-30000).
CRM_EXTRACTION_CALL_TIMEOUT_MS=
