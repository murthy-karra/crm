{
  "db_name": "PostgreSQL",
  "query": "SELECT i.id, i.organization_id, o.name as organization_name,\n             i.email, i.role, i.expires_at, i.accepted_at, i.revoked_at\n           FROM invitation i\n           JOIN organization o ON o.id = i.organization_id\n           WHERE i.id = $1 AND i.organization_id = $2\n           FOR UPDATE OF i",
