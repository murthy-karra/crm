+// A6 completion-assurance supplement. Append inside db_activity_lifecycle.rs.
+// Synthetic existing rows are deliberately seeded with the migrator: ordinary
+// mutations must remain forbidden in a migration-review workspace.
+
+#[sqlx::test]
+#[ignore]
+async fn activity_a6_audit_note_equality_edits_and_tombstones_preserve_exact_rows(
+    migrator: PgPool,
+) {
+    use crm_api::domain::migration::snapshot_source::Stream;
+
+    for scenario in [
+        "equal",
+        "body_edit",
+        "tombstone",
+        "author_edit",
+        "timestamp_edit",
+    ] {
+        // Book has one note-detail response per stream/offset; independent small
+        // Organizations keep each note source and local-state variant explicit.
+        let book = source::book();
+        book.set_records(Stream::Notes, vec![json!({"id":11,"personId":101})]);
+        book.set_raw(
+            Stream::NoteDetail,
+            0,
+            200,
+            serde_json::to_vec(&json!({
+                "id":11,"personId":101,"createdById":3,
+                "body":"Retained main note 界","isHtml":false,
+                "created":"2026-09-01T12:00:00.123456Z","updated":null
+            }))
+            .unwrap(),
+            false,
+        );
+        // A genuine eligible native unit allows confirmation even when the
+        // note is held; all-held rejection must not masquerade as protection.
+        book.set_records(Stream::TasksOpen, vec![source::task(901)]);
+        let f = support::fixture_with_book(&migrator, book).await;
+        let parent = source::completed_parent(&f).await;
+        let person: Uuid = sqlx::query_scalar(
+            "SELECT target_id FROM migration_import_identity WHERE organization_id=$1 AND import_id=$2 AND family='people' AND source_id='101'",
+        )
+        .bind(f.org)
+        .bind(parent)
+        .fetch_one(&f.pool)
+        .await
+        .unwrap();
+        let native_id = Uuid::new_v4();
+        let body = match scenario {
+            "body_edit" => "Locally edited note 界",
+            "tombstone" => "",
+            _ => "Retained main note 界",
+        };
+        let author = if scenario == "author_edit" {
+            f.member
+        } else {
+            f.actor
+        };
+        let updated = if scenario == "timestamp_edit" {
+            "2026-09-01T12:00:01.123456Z"
+        } else {
+            "2026-09-01T12:00:00.123456Z"
+        };
+        sqlx::query(
+            "INSERT INTO note(id,organization_id,person_id,author_user_id,body,origin,correlation_id,source,source_external_id,created_at,updated_at,deleted_at,deleted_by_user_id) VALUES($1,$2,$3,$4,$5,'migration',gen_random_uuid(),'fub','v1:17:11','2026-09-01T12:00:00.123456Z',$6::text::timestamptz,CASE WHEN $7 THEN '2026-09-02T12:00:00Z'::timestamptz ELSE NULL END,CASE WHEN $7 THEN $8 ELSE NULL END)",
+        )
+        .bind(native_id)
+        .bind(f.org)
+        .bind(person)
+        .bind(author)
+        .bind(body)
+        .bind(updated)
+        .bind(scenario == "tombstone")
+        .bind(f.actor)
+        .execute(&migrator)
+        .await
+        .unwrap();
+        let before: Value = sqlx::query_scalar(
+            "SELECT jsonb_agg(to_jsonb(n) ORDER BY n.id) FROM note n WHERE n.organization_id=$1",
+        )
+        .bind(f.org)
+        .fetch_one(&f.pool)
+        .await
+        .unwrap();
+        let calls = f.reader.calls();
+        let (child, initial) = source::prepare(&f, parent).await;
+        let plan =
+            source::replan(&f, child, &initial, source::choices(&f, child).await, None).await;
+        let records = activity::records(&f.pool, &f.key, &f.ctx, child, ActivityPage::default())
+            .await
+            .unwrap();
+        assert!(records["next_cursor"].is_null());
+        let note = records["items"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|r| r["kind"] == "note")
+            .unwrap();
+        let expected = if scenario == "equal" {
+            "already_present"
+        } else {
+            "held"
+        };
+        let reason = if scenario == "tombstone" {
+            "native_tombstone"
+        } else {
+            "native_local_changes"
+        };
+        assert_eq!(note["disposition"], expected, "note plan: {scenario}");
+        if scenario == "equal" {
+            assert_eq!(note["target_id"], json!(native_id));
+            assert_eq!(note["preview"]["reasons"], json!([]));
+        } else {
+            assert_eq!(
+                note["preview"]["reasons"],
+                json!([reason]),
+                "note reason: {scenario}"
+            );
+        }
+        let done = source::confirm(&f, child, &plan).await;
+        assert_eq!(
+            done["counts"]["tasks"]["applied"], "1",
+            "eligible control: {scenario}"
+        );
+        assert_eq!(done["counts"]["notes"]["applied"], "0");
+        let results = activity::results(&f.pool, &f.key, &f.ctx, child, ActivityPage::default())
+            .await
+            .unwrap();
+        assert!(results["next_cursor"].is_null());
+        assert_eq!(results["items"].as_array().unwrap().len(), 2);
+        let result = results["items"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|r| r["kind"] == "note")
+            .unwrap();
+        assert_eq!(result["disposition"], expected, "note result: {scenario}");
+        if scenario == "equal" {
+            assert_eq!(result["target_id"], json!(native_id));
+            assert_eq!(result["reasons"], json!([]));
+        } else {
+            assert!(result["target_id"].is_null());
+            assert_eq!(result["reasons"], json!([reason]));
+        }
+        let after: Value = sqlx::query_scalar(
+            "SELECT jsonb_agg(to_jsonb(n) ORDER BY n.id) FROM note n WHERE n.organization_id=$1",
+        )
+        .bind(f.org)
+        .fetch_one(&f.pool)
+        .await
+        .unwrap();
+        assert_eq!(
+            after, before,
+            "every native note column and row count must survive: {scenario}"
+        );
+        let identities: i64 = sqlx::query_scalar(
+            "SELECT count(*) FROM migration_activity_identity WHERE organization_id=$1 AND import_id=$2 AND kind='note'",
+        )
+        .bind(f.org)
+        .bind(child)
+        .fetch_one(&f.pool)
+        .await
+        .unwrap();
+        assert_eq!(identities, i64::from(scenario == "equal"));
+        assert!(!activity_worker::run_once(&f.pool, &f.key, &f.policy)
+            .await
+            .unwrap());
+        assert_eq!(f.reader.calls(), calls);
+        assert_bytes(&f, child).await;
+    }
+}
