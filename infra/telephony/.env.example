# Telephony host environment (copied to /opt/crm-telephony/.env; gitignored).
LIVEKIT_DOMAIN=livekit1.tarams.org
LIVEKIT_API_KEY=            # shared with the API's .env (LIVEKIT_API_KEY)
LIVEKIT_API_SECRET=         # shared with the API's .env (LIVEKIT_API_SECRET); never commit
LIVEKIT_WEBHOOK_URL=https://api.tarams.org/webhooks/livekit
# Egress (recording) output. Leave EGRESS_S3_BUCKET empty to run egress
# without a default S3 target (requests must then carry their own output).
# Credentials come from the EC2 instance role, never from this file.
EGRESS_S3_BUCKET=
AWS_REGION=us-west-1
