#!/usr/bin/env bash
# Verifies pinned toolchains and fetches locked dependencies. Does not
# install system toolchains or start services (D-016).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

echo "==> checking Rust toolchain"
if ! command -v rustup >/dev/null 2>&1; then
  echo "rustup is required: https://rustup.rs" >&2
  exit 1
fi
pinned_rust="$(grep '^channel' "$repo_root/rust-toolchain.toml" | sed -E 's/.*"(.+)".*/\1/')"
rustup toolchain install "$pinned_rust" --profile minimal --component rustfmt --component clippy >/dev/null
echo "    rust $pinned_rust ready"

echo "==> checking Node"
if ! command -v node >/dev/null 2>&1; then
  echo "node is required (see .node-version): https://nodejs.org" >&2
  exit 1
fi
pinned_node="$(cat "$repo_root/.node-version")"
actual_node="$(node --version | sed 's/^v//')"
if [ "$actual_node" != "$pinned_node" ]; then
  echo "node $pinned_node is required (found $actual_node). Use nvm/fnm to install and select it." >&2
  exit 1
fi
echo "    node $pinned_node ready"

echo "==> checking corepack/pnpm"
if ! command -v corepack >/dev/null 2>&1; then
  echo "corepack is required (ships with Node; run 'corepack enable')." >&2
  exit 1
fi
corepack enable >/dev/null 2>&1 || true
echo "    corepack ready"

echo "==> checking Docker"
if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required for PostgreSQL and Centrifugo in development." >&2
  exit 1
fi
echo "    docker ready"

# sqlx-cli is not a bootstrap requirement (not needed by check, dev-api, or
# this script itself) but is required for scripts/sqlx-prepare and
# scripts/check-db (docs/specs/SLICE_002.md §11) — a non-fatal warning here,
# not an install or a hard failure.
echo "==> checking sqlx-cli (required for scripts/sqlx-prepare and check-db)"
locked_minor="$(grep -A2 '^name = "sqlx"$' "$repo_root/backend/Cargo.lock" | grep '^version' | head -1 | sed -E 's/.*"([0-9]+\.[0-9]+)\.[0-9]+".*/\1/')"
if cargo sqlx --version >/dev/null 2>&1; then
  cli_version="$(cargo sqlx --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
  cli_minor="${cli_version%.*}"
  if [ "$cli_minor" = "$locked_minor" ]; then
    echo "    sqlx-cli $cli_version ready"
  else
    echo "    warning: sqlx-cli $cli_version found, but the workspace locks sqlx ${locked_minor}.x." >&2
    echo "    install the matching version: cargo install sqlx-cli --version ${locked_minor}.6 --locked --no-default-features --features postgres,rustls" >&2
  fi
else
  echo "    warning: sqlx-cli not found." >&2
  echo "    install it: cargo install sqlx-cli --version ${locked_minor}.6 --locked --no-default-features --features postgres,rustls" >&2
fi

echo "==> checking cargo-nextest (required for scripts/check and scripts/check-db)"
if command -v cargo-nextest >/dev/null 2>&1; then
  nextest_version="$(cargo nextest --version 2>&1 | head -1 | awk '{print $2}')"
  echo "    cargo-nextest $nextest_version ready"
else
  echo "    installing cargo-nextest"
  cargo install cargo-nextest --locked
fi

echo "==> fetching Cargo dependencies"
(cd "$repo_root/backend" && cargo fetch --locked)

echo "==> installing web dependencies"
(cd "$repo_root/web" && pnpm install --frozen-lockfile)

echo "==> bootstrap complete"
