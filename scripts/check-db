#!/usr/bin/env bash
# Runs the DB-backed checks and test suite against the local container.
# Requires ./scripts/dev-services up first. Never printed: any credential
# value from .env.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
env_file="$repo_root/.env"

if [ ! -f "$env_file" ]; then
  echo ".env not found at repo root. Copy .env.example to .env and fill in values first." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

if [ -z "${MIGRATION_DATABASE_URL:-}" ]; then
  echo "MIGRATION_DATABASE_URL is not set in .env" >&2
  exit 1
fi

# Step 0: Centrifugo reachability precheck (docs/specs/SLICE_003.md §13).
# This suite now includes a Centrifugo-backed test that must fail loudly,
# never skip, when the container is down (tests/centrifugo_realtime.rs
# already does this on its own); checking here too surfaces a down
# container immediately, before the slower sqlx-prepare/test steps run.
centrifugo_api_url="${CRM_CENTRIFUGO_API_URL:-http://127.0.0.1:8000/api}"
centrifugo_health_url="${centrifugo_api_url%/api}/health"
echo "==> centrifugo: health endpoint ($centrifugo_health_url)"
if ! curl -fsS --max-time 2 "$centrifugo_health_url" >/dev/null 2>&1; then
  echo "Centrifugo not reachable at $centrifugo_health_url. Run ./scripts/dev-services up first." >&2
  exit 1
fi

# Step 1: verify backend/.sqlx/ still matches the real schema (catches
# nullability/type drift an offline compile cannot) — a throwaway,
# freshly-migrated database, never the dev database (docs/specs/SLICE_002.md
# §11). The subsequent test run stays offline.
echo "==> cargo sqlx prepare --check --workspace"
prepare_check_url="${MIGRATION_DATABASE_URL%/*}/crm_sqlx_prepare_check"

cleanup() {
  (cd "$repo_root/backend" && cargo sqlx database drop -y --database-url "$prepare_check_url" >/dev/null 2>&1) || true
}
trap cleanup EXIT

(
  cd "$repo_root/backend"
  cargo sqlx database create --database-url "$prepare_check_url"
  cargo sqlx migrate run --source crates/crm-api/migrations --database-url "$prepare_check_url"
  DATABASE_URL="$prepare_check_url" SQLX_OFFLINE=false cargo sqlx prepare --check --workspace
)

cleanup
trap - EXIT

# Step 2: the DB-backed test suite. #[sqlx::test] reads its master
# connection from DATABASE_URL specifically (not a configurable attribute),
# so it is overridden here to the crm_migrator URL for this process only —
# the one documented exception to "tests never read ambient environment"
# (docs/specs/SLICE_001.md §9).
export DATABASE_URL="$MIGRATION_DATABASE_URL"

echo "==> cargo test -- --ignored"
cd "$repo_root/backend"
exec cargo test --manifest-path Cargo.toml --workspace --locked -- --ignored
