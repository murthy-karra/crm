#!/usr/bin/env bash
# Runs the DB-backed test suite (Slice 001) against the local container.
# Requires ./scripts/dev-services up first. Never printed: any credential
# value from .env.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
env_file="$repo_root/.env"

if [ ! -f "$env_file" ]; then
  echo ".env not found at repo root. Copy .env.example to .env and fill in values first." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

# #[sqlx::test] reads its master connection from DATABASE_URL specifically
# (not a configurable attribute), so it is overridden here to the
# crm_migrator URL for this process only — the one documented exception to
# "tests never read ambient environment" (docs/specs/SLICE_001.md §9).
export DATABASE_URL="$MIGRATION_DATABASE_URL"

cd "$repo_root/backend"
exec cargo test --manifest-path Cargo.toml -p crm-api --locked -- --ignored
