#!/usr/bin/env bash
# Verifies the local PostgreSQL and Centrifugo containers are healthy.
# Outside ./scripts/check so the repository gate stays service-free.
# Credential values are read inside each container from its own
# already-injected environment; this script never handles them.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
compose_file="$repo_root/infra/development/compose.yaml"
env_file="$repo_root/.env"

if [ ! -f "$env_file" ]; then
  echo ".env not found at repo root. Copy .env.example to .env and fill in values first." >&2
  exit 1
fi

compose() {
  docker compose -f "$compose_file" --env-file "$env_file" "$@"
}

echo "==> postgres: pg_isready"
compose exec -T postgres sh -c 'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

echo "==> postgres: SELECT 1"
compose exec -T postgres sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "SELECT 1;"' >/dev/null

echo "==> centrifugo: health endpoint"
compose exec -T centrifugo wget --quiet --tries=1 --spider http://127.0.0.1:8000/health

echo "==> services healthy"
