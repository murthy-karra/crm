#!/usr/bin/env bash
# Idempotently bootstraps the platform admin (owner@platform.test) and
# seeds two Organizations, each with two local-auth Users — one admin, one
# member — every row through the crm-admin CLI's domain functions
# (docs/specs/SLICE_004.md §1, §11). Replaces scripts/dev-seed.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

cd "$repo_root"
cargo run --manifest-path backend/Cargo.toml -p crm-api --bin crm-admin -- \
  bootstrap-platform-admin --email owner@platform.test --display-name "Platform Owner"
cargo run --manifest-path backend/Cargo.toml -p crm-api --bin crm-admin -- seed-dev
