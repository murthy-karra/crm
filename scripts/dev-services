#!/usr/bin/env bash
# Starts/stops the local PostgreSQL and Centrifugo containers (D-016).
# Never runs `docker compose config` — it would print resolved values
# from .env, including secrets.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
compose_file="$repo_root/infra/development/compose.yaml"
env_file="$repo_root/.env"
provision_sql="$repo_root/infra/development/postgres/provision-roles.sql"

if [ ! -f "$env_file" ]; then
  echo ".env not found at repo root. Copy .env.example to .env and fill in values first." >&2
  exit 1
fi

compose() {
  docker compose -f "$compose_file" --env-file "$env_file" "$@"
}

action="${1:-up}"

case "$action" in
  up)
    compose up -d --wait
    echo "==> provisioning crm_migrator/crm_app database roles"
    # Credentials come from the container's own environment, never this
    # script's, matching check-services' pattern.
    compose exec -T postgres sh -c 'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' < "$provision_sql"
    ;;
  down)
    compose down
    ;;
  status)
    compose ps
    ;;
  *)
    echo "usage: $0 [up|down|status]" >&2
    exit 1
    ;;
esac
