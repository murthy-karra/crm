#!/usr/bin/env bash
# Runs the Cloudflare tunnel for the web dev server and API (D-016).
# crm-dev is a locally-managed tunnel: its ingress lives in
# infra/development/cloudflared/config.yml (no secret — auth is the
# credentials file cloudflared already wrote outside the repo at tunnel
# creation time), not the Cloudflare dashboard or a token. The DNS route,
# and the Access application, are one-time Cloudflare steps documented in
# the README.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
config_file="$repo_root/infra/development/cloudflared/config.yml"

if [ ! -f "$config_file" ]; then
  echo "Missing $config_file — see README 'External connectivity' for setup." >&2
  exit 1
fi

if ! command -v cloudflared >/dev/null 2>&1; then
  echo "cloudflared is required: brew install cloudflared" >&2
  exit 1
fi

echo "==> starting cloudflared tunnel (crm-dev)"
echo "==> before trusting either hostname, verify an unauthenticated request to BOTH app.tarams.org and api.tarams.org hits the Cloudflare Access challenge, not the app"

exec cloudflared tunnel --config "$config_file" run
