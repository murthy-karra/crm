#!/usr/bin/env bash
# Posts a fixture .eml file to POST /inbound/email as a real inbound
# delivery would (docs/specs/SLICE_007b.md §1, §11): dev stand-in for real
# receiving until 007g. Never printed and never on argv (visible in `ps`):
# CRM_INBOUND_EMAIL_SECRET. No -v, no set -x.
#
# Usage: scripts/inbound-email <recipient> <fixture.eml>
#   recipient  e.g. leads-k7f3q2wd@acme-realty.elysianfeld.com (copy from
#              Manage -> Intake in the web app)
#   fixture.eml  path to a raw RFC 822 file, e.g.
#              backend/crates/crm-api/tests/fixtures/email/plain.eml
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
env_file="$repo_root/.env"

if [ $# -ne 2 ]; then
  echo "usage: $0 <recipient> <fixture.eml>" >&2
  exit 1
fi
recipient="$1"
fixture="$2"

if [ ! -f "$env_file" ]; then
  echo ".env not found at repo root. Copy .env.example to .env and fill in values first." >&2
  exit 1
fi
if [ ! -f "$fixture" ]; then
  echo "fixture file not found: $fixture" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

if [ -z "${CRM_INBOUND_EMAIL_SECRET:-}" ]; then
  echo "CRM_INBOUND_EMAIL_SECRET is not set in .env" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required (used to build the JSON request body)." >&2
  exit 1
fi

api_url="${CRM_DEMO_API_URL:-http://127.0.0.1:3000}"

# mktemp + trap cleanup (docs/specs/SLICE_003.md §11 convention).
response_file="$(mktemp)"
cleanup() {
  rm -f "$response_file"
}
trap cleanup EXIT

echo "==> posting $fixture to $recipient at $api_url/inbound/email"

# base64 without line-wrapping (spec §11: "strict padded standard base64,
# no embedded whitespace"). GNU coreutils takes a bare positional file and
# -w0; BSD/macOS's base64 has no positional-file form (needs -i) and takes
# -b 0 (space-separated) to mean "don't break".
if base64 --help 2>&1 | grep -q -- '-w'; then
  raw_b64="$(base64 -w0 "$fixture")"
else
  raw_b64="$(base64 -b 0 -i "$fixture" | tr -d '\n')"
fi

body="$(jq -n --arg recipient "$recipient" --arg raw "$raw_b64" \
  '{recipient: $recipient, raw: $raw}')"

status="$(
  printf '%s' "$body" \
    | curl -sS -o "$response_file" -w '%{http_code}' \
        -X POST "$api_url/inbound/email" \
        -H "authorization: Bearer ${CRM_INBOUND_EMAIL_SECRET}" \
        -H 'content-type: application/json' \
        --data-binary @-
)"
response="$(cat "$response_file")"

echo "==> HTTP $status: $response"

if [ "$status" != "200" ]; then
  exit 1
fi
