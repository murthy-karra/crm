    object_fields(admitted_metadata, {"present", "compatible"})
    if any(type(admitted_metadata[key]) is not bool for key in ["present", "compatible"]):
        fail("database_evidence_invalid")
    if admitted_metadata["present"] != admitted_metadata["compatible"]:
        fail("admitted_metadata_schema_incomplete")
    state["admitted_metadata_schema_present"] = admitted_metadata["present"]
    state["admitted_metadata_binding_count"] = "0"
    state["admitted_metadata_unsupported_count"] = "0"
    if admitted_metadata["present"]:
        observed = sql_json("SELECT json_build_object('count',((SELECT count(*) FROM public.migration_metadata_catalog_readiness WHERE state='ready')+(SELECT count(*) FROM public.migration_admitted_metadata_import))::text,'unsupported_count',((SELECT count(*) FROM public.migration_metadata_catalog_readiness WHERE state='ready' AND engine_version IS DISTINCT FROM 'fub-admitted-metadata-v1')+(SELECT count(*) FROM public.migration_admitted_metadata_import WHERE engine_version<>'fub-admitted-metadata-v1'))::text)")
        object_fields(observed, {"count", "unsupported_count"})
        state["admitted_metadata_binding_count"] = observed["count"]
        state["admitted_metadata_unsupported_count"] = observed["unsupported_count"]
    activity_schema_path = Path(__file__).resolve().parents[1] / "backend/crates/crm-app/src/auth/admitted_activity_schema.sql"
    try:
        activity_schema = activity_schema_path.read_text(encoding="utf-8").strip()
    except OSError:
        fail("admitted_activity_schema_inventory_unavailable")
    admitted_activity = sql_json("SELECT json_build_object('present',(to_regclass('public.migration_admitted_activity_import') IS NOT NULL OR to_regprocedure('public.crm_admitted_activity_insert_allowed(uuid,text,jsonb)') IS NOT NULL OR EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_activity_identity') AND attname IN ('admitted_import_id','admitted_plan_id','admitted_manifest_id') AND NOT attisdropped)), 'compatible',(" + activity_schema + "))")
    object_fields(admitted_activity, {"present", "compatible"})
    if any(type(admitted_activity[key]) is not bool for key in ["present", "compatible"]):
        fail("database_evidence_invalid")
    if admitted_activity["present"] != admitted_activity["compatible"]:
        fail("admitted_activity_schema_incomplete")
    state["admitted_activity_schema_present"] = admitted_activity["present"]
    state["admitted_activity_binding_count"] = "0"
    state["admitted_activity_unsupported_count"] = "0"
    if admitted_activity["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text,'unsupported_count',count(*) FILTER (WHERE source_output_revision IS NULL OR admission_plan_id IS NULL)::text) FROM public.migration_admitted_activity_import")
        object_fields(observed, {"count", "unsupported_count"})
        state["admitted_activity_binding_count"] = observed["count"]
        state["admitted_activity_unsupported_count"] = observed["unsupported_count"]
    admitted_history_schema_path = Path(__file__).resolve().parents[1] / "backend/crates/crm-app/src/auth/admitted_history_schema.sql"
    try:
        admitted_history_schema = admitted_history_schema_path.read_text(encoding="utf-8").strip()
    except OSError:
        fail("admitted_history_schema_inventory_unavailable")
    admitted_history = sql_json("SELECT json_build_object('present',(to_regclass('public.migration_admitted_history_root') IS NOT NULL OR to_regprocedure('public.crm_admitted_history_fact_allowed(jsonb,text)') IS NOT NULL OR EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_history_import_identity') AND attname='admitted_root_id' AND NOT attisdropped)), 'compatible',(" + admitted_history_schema + "))")
    object_fields(admitted_history, {"present", "compatible"})
    if any(type(admitted_history[key]) is not bool for key in ["present", "compatible"]):
        fail("database_evidence_invalid")
    if admitted_history["present"] != admitted_history["compatible"]:
        fail("admitted_history_schema_incomplete")
    state["admitted_history_schema_present"] = admitted_history["present"]
    state["admitted_history_binding_count"] = "0"
    state["admitted_history_unsupported_count"] = "0"
    if admitted_history["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text,'unsupported_count',count(*) FILTER (WHERE p.source_binding->>'interpretation_version' IS DISTINCT FROM 'fub-history-interpretation-v1' OR p.source_binding->>'identity_version' IS DISTINCT FROM 'timeline-import-identity-v1')::text) FROM public.migration_admitted_history_root r JOIN public.migration_admitted_history_plan p ON p.id=r.confirmed_plan_id AND p.organization_id=r.organization_id")
        object_fields(observed, {"count", "unsupported_count"})
        state["admitted_history_binding_count"] = observed["count"]
        state["admitted_history_unsupported_count"] = observed["unsupported_count"]
    mapping_repair_schema_path = Path(__file__).resolve().parents[1] / "backend/crates/crm-app/src/auth/mapping_repair_schema.sql"
    try:
        mapping_repair_schema = mapping_repair_schema_path.read_text(encoding="utf-8").strip()
    except OSError:
        fail("mapping_repair_schema_inventory_unavailable")
    mapping_repair = sql_json("SELECT json_build_object('present',(to_regclass('public.migration_mapping_repair_requirement') IS NOT NULL OR to_regprocedure('public.crm_mapping_repair_owned_write()') IS NOT NULL),'compatible',(" + mapping_repair_schema + "))")
    object_fields(mapping_repair, {"present", "compatible"})
    if any(type(mapping_repair[k]) is not bool for k in ["present", "compatible"]) or mapping_repair["present"] != mapping_repair["compatible"]:
        fail("mapping_repair_schema_incomplete")
    state["mapping_repair_schema_present"] = mapping_repair["present"]
    state["mapping_repair_binding_count"] = "0"
