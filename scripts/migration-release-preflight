#!/usr/bin/env python3
"""Read-only, operator-owned release evidence for the 010c workspace gate.

Usage: migration-release-preflight --artifacts known-builds.json
       --candidates candidates.json --inventory processes.json
       --target environment-id --purpose launch|confirm

The database is queried with psql using the operator's standard libpq PG*
environment. No credentials are accepted on argv, printed, or read from JSON.
All three files must be owned by this OS user/root and not group/world writable.
They describe verified deployment facts, never tenant-supplied authorization.

JSON inputs (version is numeric 1; counts in the report are decimal strings):
  artifacts: {version, artifacts:[{sha256,role,gate_version,revision,capabilities?}]}
  candidates: {version, artifacts:[{role,path}]}
  inventory: {version,target,observed_at,complete,pre_010c_retired,
              processes:[{id,role,sha256}]}
Roles: api, worker, cli, migrator. Known gate versions: crm-workspace-v1,
pre-010c. Revisions are full Git hashes. Inventory timestamps are UTC RFC3339;
the complete inventory must be no older than five minutes. It covers active
processes/workloads AND launch/admin paths, including in-process workers.
Known optional capabilities: fub-metadata-import-v1, fub-activity-import-v1,
fub-history-capture-v1, fub-history-timeline-v1, fub-core-change-v1,
fub-people-refresh-v1, fub-people-admission-v1, fub-admitted-people-refresh-v1,
fub-admitted-metadata-v1. Confirmed history captures require history-capable API/
worker launch and recovery, including completed/cancelled runs. Unconfirmed
proposals do not impose this requirement. Unsupported confirmed source/parser
profiles fail closed. History confirmation readiness is reported separately.
Confirmed timeline anchors independently require timeline-capable API/worker
artifacts, even after cancellation/erasure or without inserted facts. Complete
inventory must demonstrate retirement of all unsupported artifacts before new
history import; old startup code cannot discover this new anchor table.
Omission means none. Confirmed activity bindings require activity-capable API/
worker launch and recovery even when cancelled without native writes.
Metadata confirmation additionally requires that capability on every selected
candidate and inventoried process with role api or worker. CLI/migrator paths
still need only the ordinary workspace gate. This does not change --purpose
launch|confirm: the report separately exposes metadata_confirmation_ready.

Retained People-refresh bindings require fub-people-refresh-v1 on API/worker
launch and recovery artifacts, including completed/cancelled rows. Confirmation
also requires a capable API/worker candidate and the refresh table, plan, item,
baseline and crm_people_refresh_mutation_allowed(uuid,text,text,text,jsonb) database guard. CLI/migrator
inventory remains compatible without this capability.

Retained People-admission state independently requires fub-people-admission-v1
on API/worker launch and recovery, including cancelled/completed runs. Its
confirmation requires a capable API/worker candidate, the complete admission
workflow/provenance/fact schema, source-identity origin columns and private
admission guard. Partial schemas and unknown retained engines fail closed.

Admitted metadata readiness requires the complete schema and compatible API/worker
fleet before the first atomic catalog handover. A ready handover independently
binds compatible recovery even before any admitted child is confirmed and after
preview cancellation; all retained admitted roots also bind this capability.
The report's admitted_metadata_confirmation_ready means the fleet/schema can
begin that handover, not that the database registry has already become ready.

Exit 0 means the requested purpose passes; 1 means policy blocked; 2 means
invalid/unavailable evidence. JSON stdout contains no source/customer content.
This script neither deploys nor terminates processes, changes bindings, enables
confirmation, or signs a runtime permit. Run it immediately before launch;
startup/confirmation independently enforce current server-owned gate state.
"""

import argparse
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

GATE = "crm-workspace-v1"
LEGACY = "pre-010c"
ROLES = frozenset({"api", "worker", "cli", "migrator"})
METADATA_CAPABILITY = "fub-metadata-import-v1"
ACTIVITY_CAPABILITY = "fub-activity-import-v1"
HISTORY_CAPABILITY = "fub-history-capture-v1"
TIMELINE_CAPABILITY = "fub-history-timeline-v1"
CORE_CHANGE_CAPABILITY = "fub-core-change-v1"
PEOPLE_REFRESH_CAPABILITY = "fub-people-refresh-v1"
PEOPLE_ADMISSION_CAPABILITY = "fub-people-admission-v1"
ADMITTED_PEOPLE_REFRESH_CAPABILITY = "fub-admitted-people-refresh-v1"
ADMITTED_METADATA_CAPABILITY = "fub-admitted-metadata-v1"
ADMITTED_ACTIVITY_CAPABILITY = "fub-admitted-activity-v1"
ADMITTED_HISTORY_CAPABILITY = "fub-admitted-history-v1"
MAPPING_REPAIR_CAPABILITY = "fub-people-mapping-repair-v1"
CAPABILITIES = frozenset({METADATA_CAPABILITY, ACTIVITY_CAPABILITY, HISTORY_CAPABILITY,
                        TIMELINE_CAPABILITY, CORE_CHANGE_CAPABILITY, PEOPLE_REFRESH_CAPABILITY,
                        PEOPLE_ADMISSION_CAPABILITY, ADMITTED_PEOPLE_REFRESH_CAPABILITY,
                        ADMITTED_METADATA_CAPABILITY, ADMITTED_ACTIVITY_CAPABILITY, ADMITTED_HISTORY_CAPABILITY, MAPPING_REPAIR_CAPABILITY})
MAX_JSON_BYTES = 1024 * 1024
MAX_ENTRIES = 4096
MAX_AGE_SECONDS = 300
MAX_FUTURE_SECONDS = 30
HEX64 = re.compile(r"[0-9a-f]{64}\Z")
REVISION = re.compile(r"(?:[0-9a-f]{40}|[0-9a-f]{64})\Z")
LABEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}\Z")


class EvidenceError(Exception):
    """Closed error code only; never render underlying input or subprocess errors."""


def fail(code="invalid_evidence"):
    raise EvidenceError(code)


def object_fields(value, fields):
    if not isinstance(value, dict) or set(value) != set(fields):
        fail()


def versioned(value, array_key):
    object_fields(value, {"version", array_key})
    if type(value["version"]) is not int or value["version"] != 1:
        fail()
    entries = value[array_key]
    if not isinstance(entries, list) or len(entries) > MAX_ENTRIES:
        fail()
    return entries


def timestamp(value):
    if (not isinstance(value, str)
            or re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,6})?Z", value) is None):
        fail()
    try:
        parsed = dt.datetime.fromisoformat(value[:-1] + "+00:00")
    except ValueError:
        fail()
    if parsed.utcoffset() != dt.timedelta(0):
        fail()
    return parsed


def utc_text(value):
    return value.astimezone(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def matches(pattern, value):
    return isinstance(value, str) and pattern.fullmatch(value) is not None


def valid_role(value):
    return isinstance(value, str) and value in ROLES


def known_artifacts(document):
    known = {}
    for item in versioned(document, "artifacts"):
        fields = {"sha256", "role", "gate_version", "revision"}
        if isinstance(item, dict) and "capabilities" in item:
            fields.add("capabilities")
        object_fields(item, fields)
        if (not matches(HEX64, item["sha256"])
                or not valid_role(item["role"])
                or not isinstance(item["gate_version"], str)
                or item["gate_version"] not in {GATE, LEGACY}
                or not matches(REVISION, item["revision"])):
            fail()
        capabilities = item.get("capabilities", [])
        if (not isinstance(capabilities, list) or len(capabilities) > len(CAPABILITIES)
                or any(not isinstance(value, str) or value not in CAPABILITIES
                       for value in capabilities)
                or len(set(capabilities)) != len(capabilities)):
            fail()
        key = (item["role"], item["sha256"])
        if key in known:
            fail()
        known[key] = {**item, "capabilities": sorted(capabilities)}
    return known


def validate_state(state):
    fields = {"schema_present", "binding_count", "gate_versions", "database_name"}
    if "activity_binding_count" in state:
        fields |= {"activity_binding_count", "activity_schema_present"}
    history_fields = {"history_capture_binding_count", "history_capture_schema_present",
                      "history_capture_unsupported_count"}
    if history_fields.intersection(state):
        fields |= history_fields
    timeline_fields = {"history_timeline_binding_count", "history_timeline_schema_present",
                       "history_timeline_unsupported_count"}
    if timeline_fields.intersection(state):
        fields |= timeline_fields
    core_change_fields = {"core_change_binding_count", "core_change_schema_present",
                       "core_change_unsupported_count"}
    if core_change_fields.intersection(state):
        fields |= core_change_fields
    people_refresh_fields = {"people_refresh_binding_count", "people_refresh_schema_present",
                             "people_refresh_unsupported_count"}
    if people_refresh_fields.intersection(state):
        fields |= people_refresh_fields
    people_admission_fields = {"people_admission_binding_count", "people_admission_schema_present",
                             "people_admission_unsupported_count"}
    if people_admission_fields.intersection(state):
        fields |= people_admission_fields
    admitted_people_refresh_fields = {"admitted_people_refresh_binding_count", "admitted_people_refresh_schema_present",
                             "admitted_people_refresh_unsupported_count"}
    if admitted_people_refresh_fields.intersection(state):
        fields |= admitted_people_refresh_fields
    admitted_metadata_fields = {"admitted_metadata_binding_count", "admitted_metadata_schema_present",
                                "admitted_metadata_unsupported_count"}
    if admitted_metadata_fields.intersection(state):
        fields |= admitted_metadata_fields
    admitted_activity_fields = {"admitted_activity_binding_count", "admitted_activity_schema_present",
                                "admitted_activity_unsupported_count"}
    if admitted_activity_fields.intersection(state):
        fields |= admitted_activity_fields
    admitted_history_fields = {"admitted_history_binding_count", "admitted_history_schema_present",
                                "admitted_history_unsupported_count"}
    if admitted_history_fields.intersection(state):
        fields |= admitted_history_fields
    mapping_repair_fields = {"mapping_repair_binding_count", "mapping_repair_schema_present",
                                "mapping_repair_unsupported_count"}
    if mapping_repair_fields.intersection(state):
        fields |= mapping_repair_fields
    object_fields(state, fields)
    if (type(state.get("activity_schema_present", False)) is not bool
            or not isinstance(state.get("activity_binding_count", "0"), str)
            or re.fullmatch(r"0|[1-9][0-9]{0,19}", state.get("activity_binding_count", "0")) is None
            or (not state.get("activity_schema_present", False) and int(state.get("activity_binding_count", "0")) != 0)):
        fail("database_evidence_invalid")
    history_count = state.get("history_capture_binding_count", "0")
    history_unsupported = state.get("history_capture_unsupported_count", "0")
    if (type(state.get("history_capture_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [history_count, history_unsupported])
            or int(history_unsupported) > int(history_count)
            or (not state.get("history_capture_schema_present", False) and int(history_count) != 0)):
        fail("database_evidence_invalid")
    timeline_count = state.get("history_timeline_binding_count", "0")
    timeline_unsupported = state.get("history_timeline_unsupported_count", "0")
    if (type(state.get("history_timeline_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [timeline_count, timeline_unsupported])
            or int(timeline_unsupported) > int(timeline_count)
            or (not state.get("history_timeline_schema_present", False) and int(timeline_count) != 0)):
        fail("database_evidence_invalid")
    core_change_count = state.get("core_change_binding_count", "0")
    core_change_unsupported = state.get("core_change_unsupported_count", "0")
    if (type(state.get("core_change_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [core_change_count, core_change_unsupported])
            or int(core_change_unsupported) > int(core_change_count)
            or (not state.get("core_change_schema_present", False) and int(core_change_count) != 0)):
        fail("database_evidence_invalid")
    people_refresh_count = state.get("people_refresh_binding_count", "0")
    people_refresh_unsupported = state.get("people_refresh_unsupported_count", "0")
    if (type(state.get("people_refresh_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [people_refresh_count, people_refresh_unsupported])
            or int(people_refresh_unsupported) > int(people_refresh_count)
            or (not state.get("people_refresh_schema_present", False)
                and int(people_refresh_count) != 0)):
        fail("database_evidence_invalid")
    people_admission_count = state.get("people_admission_binding_count", "0")
    people_admission_unsupported = state.get("people_admission_unsupported_count", "0")
    if (type(state.get("people_admission_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [people_admission_count, people_admission_unsupported])
            or int(people_admission_unsupported) > int(people_admission_count)
            or (not state.get("people_admission_schema_present", False)
                and int(people_admission_count) != 0)):
        fail("database_evidence_invalid")
    admitted_people_refresh_count = state.get("admitted_people_refresh_binding_count", "0")
    admitted_people_refresh_unsupported = state.get("admitted_people_refresh_unsupported_count", "0")
    if (type(state.get("admitted_people_refresh_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [admitted_people_refresh_count, admitted_people_refresh_unsupported])
            or int(admitted_people_refresh_unsupported) > int(admitted_people_refresh_count)
            or (not state.get("admitted_people_refresh_schema_present", False)
                and int(admitted_people_refresh_count) != 0)):
        fail("database_evidence_invalid")
    admitted_metadata_count = state.get("admitted_metadata_binding_count", "0")
    admitted_metadata_unsupported = state.get("admitted_metadata_unsupported_count", "0")
    if (type(state.get("admitted_metadata_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [admitted_metadata_count, admitted_metadata_unsupported])
            or int(admitted_metadata_unsupported) > int(admitted_metadata_count)
            or (not state.get("admitted_metadata_schema_present", False)
                and int(admitted_metadata_count) != 0)):
        fail("database_evidence_invalid")
    admitted_activity_count = state.get("admitted_activity_binding_count", "0")
    admitted_activity_unsupported = state.get("admitted_activity_unsupported_count", "0")
    if (type(state.get("admitted_activity_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [admitted_activity_count, admitted_activity_unsupported])
            or int(admitted_activity_unsupported) > int(admitted_activity_count)
            or (not state.get("admitted_activity_schema_present", False)
                and int(admitted_activity_count) != 0)):
        fail("database_evidence_invalid")
    admitted_history_count = state.get("admitted_history_binding_count", "0")
    admitted_history_unsupported = state.get("admitted_history_unsupported_count", "0")
    if (type(state.get("admitted_history_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [admitted_history_count, admitted_history_unsupported])
            or int(admitted_history_unsupported) > int(admitted_history_count)
            or (not state.get("admitted_history_schema_present", False)
                and int(admitted_history_count) != 0)):
        fail("database_evidence_invalid")
    mapping_repair_count = state.get("mapping_repair_binding_count", "0")
    mapping_repair_unsupported = state.get("mapping_repair_unsupported_count", "0")
    if (type(state.get("mapping_repair_schema_present", False)) is not bool
            or any(not isinstance(value, str)
                   or re.fullmatch(r"0|[1-9][0-9]{0,19}", value) is None
                   for value in [mapping_repair_count, mapping_repair_unsupported])
            or int(mapping_repair_unsupported) > int(mapping_repair_count)
            or (not state.get("mapping_repair_schema_present", False)
                and int(mapping_repair_count) != 0)):
        fail("database_evidence_invalid")
    count = state["binding_count"]
    if (type(state["schema_present"]) is not bool
            or not isinstance(count, str)
            or re.fullmatch(r"0|[1-9][0-9]{0,19}", count) is None
            or not isinstance(state["database_name"], str)
            or not 1 <= len(state["database_name"]) <= 128):
        fail("database_evidence_invalid")
    versions = state["gate_versions"]
    if (not isinstance(versions, list) or len(versions) > MAX_ENTRIES
            or any(not isinstance(v, str) or not 1 <= len(v) <= 128 for v in versions)
            or len(set(versions)) != len(versions)
            or (int(count) == 0) != (len(versions) == 0)
            or (not state["schema_present"] and int(count) != 0)):
        fail("database_evidence_invalid")


def evaluate(artifacts, candidates, inventory, state, target, now):
    """Pure evaluator. Only main() supplies production state from live SQL."""
    known = known_artifacts(artifacts)
    validate_state(state)
    if not matches(LABEL, target):
        fail()
    object_fields(inventory, {
        "version", "target", "observed_at", "complete", "pre_010c_retired", "processes",
    })
    if (type(inventory["version"]) is not int or inventory["version"] != 1
            or not matches(LABEL, inventory["target"])
            or type(inventory["complete"]) is not bool
            or type(inventory["pre_010c_retired"]) is not bool
            or not isinstance(inventory["processes"], list)
            or len(inventory["processes"]) > MAX_ENTRIES):
        fail()
    observed = timestamp(inventory["observed_at"])
    reasons = set()
    if inventory["target"] != target:
        reasons.add("inventory_target_mismatch")
    age = (now - observed).total_seconds()
    if age > MAX_AGE_SECONDS or age < -MAX_FUTURE_SECONDS:
        reasons.add("inventory_stale")
    if not inventory["complete"]:
        reasons.add("inventory_incomplete")

    selected = []
    candidate_keys = set()
    for item in versioned(candidates, "artifacts"):
        # Production candidates have been hashed from files before evaluation.
        object_fields(item, {"role", "sha256"})
        if not valid_role(item["role"]) or not matches(HEX64, item["sha256"]):
            fail()
        key = (item["role"], item["sha256"])
        if key in candidate_keys:
            fail()
        candidate_keys.add(key)
        match = known.get(key)
        if match is None:
            reasons.add("candidate_unknown")
        selected.append({
            "role": item["role"], "sha256": item["sha256"],
            "gate_version": match["gate_version"] if match else None,
            "revision": match["revision"] if match else None,
            "capabilities": match["capabilities"] if match else [],
        })
    if not selected:
        reasons.add("candidate_missing")

    process_ids = set()
    active_gates = set()
    processes = []
    for process in inventory["processes"]:
        object_fields(process, {"id", "role", "sha256"})
        if (not matches(LABEL, process["id"]) or not valid_role(process["role"])
                or not matches(HEX64, process["sha256"])):
            fail()
        if process["id"] in process_ids:
            fail()
        process_ids.add(process["id"])
        match = known.get((process["role"], process["sha256"]))
        if match is None:
            reasons.add("process_unknown")
        else:
            active_gates.add(match["gate_version"])
        processes.append({
            "id": process["id"], "role": process["role"], "sha256": process["sha256"],
            "gate_version": match["gate_version"] if match else None,
            "revision": match["revision"] if match else None,
            "capabilities": match["capabilities"] if match else [],
        })

    candidate_gates = {item["gate_version"] for item in selected if item["gate_version"]}
    all_gates = candidate_gates | active_gates
    if GATE in all_gates and LEGACY in all_gates:
        reasons.add("mixed_gate_fleet")
    if inventory["pre_010c_retired"] and LEGACY in active_gates:
        reasons.add("retirement_contradicted")
    if int(state["binding_count"]) > 0:
        if set(state["gate_versions"]) != {GATE}:
            reasons.add("binding_gate_unsupported")
        if LEGACY in all_gates:
            reasons.add("review_binding_requires_compatible_artifacts")
        if not inventory["pre_010c_retired"]:
            reasons.add("retirement_required")

    activity_missing = any(item["role"] in {"api", "worker"}
                           and ACTIVITY_CAPABILITY not in item["capabilities"]
                           for item in selected + processes)
    if int(state.get("activity_binding_count", "0")) > 0 and activity_missing:
        reasons.add("activity_binding_requires_compatible_artifacts")
    history_missing = any(item["role"] in {"api", "worker"}
                          and HISTORY_CAPABILITY not in item["capabilities"]
                          for item in selected + processes)
    if int(state.get("history_capture_binding_count", "0")) > 0 and history_missing:
        reasons.add("history_capture_binding_requires_compatible_artifacts")
    if int(state.get("history_capture_unsupported_count", "0")) > 0:
        reasons.add("history_capture_profile_unsupported")
    timeline_missing = any(item["role"] in {"api", "worker"}
                           and TIMELINE_CAPABILITY not in item["capabilities"]
                           for item in selected + processes)
    if int(state.get("history_timeline_binding_count", "0")) > 0 and timeline_missing:
        reasons.add("history_timeline_binding_requires_compatible_artifacts")
    if int(state.get("history_timeline_unsupported_count", "0")) > 0:
        reasons.add("history_timeline_profile_unsupported")
    core_change_missing = any(item["role"] in {"api", "worker"}
                           and CORE_CHANGE_CAPABILITY not in item["capabilities"]
                           for item in selected + processes)
    if int(state.get("core_change_binding_count", "0")) > 0 and core_change_missing:
        reasons.add("core_change_binding_requires_compatible_artifacts")
    if int(state.get("core_change_unsupported_count", "0")) > 0:
        reasons.add("core_change_profile_unsupported")
    people_refresh_missing = any(item["role"] in {"api", "worker"}
                                 and PEOPLE_REFRESH_CAPABILITY not in item["capabilities"]
                                 for item in selected + processes)
    if int(state.get("people_refresh_binding_count", "0")) > 0 and people_refresh_missing:
        reasons.add("people_refresh_binding_requires_compatible_artifacts")
    if int(state.get("people_refresh_unsupported_count", "0")) > 0:
        reasons.add("people_refresh_engine_unsupported")
    people_admission_missing = any(item["role"] in {"api", "worker"}
                                 and PEOPLE_ADMISSION_CAPABILITY not in item["capabilities"]
                                 for item in selected + processes)
    if int(state.get("people_admission_binding_count", "0")) > 0 and people_admission_missing:
        reasons.add("people_admission_binding_requires_compatible_artifacts")
    if int(state.get("people_admission_unsupported_count", "0")) > 0:
        reasons.add("people_admission_engine_unsupported")
    admitted_people_refresh_missing = any(item["role"] in {"api", "worker"}
                                 and ADMITTED_PEOPLE_REFRESH_CAPABILITY not in item["capabilities"]
                                 for item in selected + processes)
    if int(state.get("admitted_people_refresh_binding_count", "0")) > 0 and admitted_people_refresh_missing:
        reasons.add("admitted_people_refresh_binding_requires_compatible_artifacts")
    if int(state.get("admitted_people_refresh_unsupported_count", "0")) > 0:
        reasons.add("admitted_people_refresh_engine_unsupported")
    admitted_metadata_missing = any(item["role"] in {"api", "worker"}
                                 and ADMITTED_METADATA_CAPABILITY not in item["capabilities"]
                                 for item in selected + processes)
    if int(state.get("admitted_metadata_binding_count", "0")) > 0 and admitted_metadata_missing:
        reasons.add("admitted_metadata_binding_requires_compatible_artifacts")
    if int(state.get("admitted_metadata_unsupported_count", "0")) > 0:
        reasons.add("admitted_metadata_engine_unsupported")
    admitted_activity_missing = any(item["role"] in {"api", "worker"}
                                 and ADMITTED_ACTIVITY_CAPABILITY not in item["capabilities"]
                                 for item in selected + processes)
    if int(state.get("admitted_activity_binding_count", "0")) > 0 and admitted_activity_missing:
        reasons.add("admitted_activity_binding_requires_compatible_artifacts")
    if int(state.get("admitted_activity_unsupported_count", "0")) > 0:
        reasons.add("admitted_activity_engine_unsupported")
    admitted_history_missing = any(item["role"] in {"api", "worker"}
                                 and ADMITTED_HISTORY_CAPABILITY not in item["capabilities"]
                                 for item in selected + processes)
    if int(state.get("admitted_history_binding_count", "0")) > 0 and admitted_history_missing:
        reasons.add("admitted_history_binding_requires_compatible_artifacts")
    if int(state.get("admitted_history_unsupported_count", "0")) > 0:
        reasons.add("admitted_history_engine_unsupported")
    mapping_repair_missing = any(item["role"] in {"api", "worker"}
                                 and MAPPING_REPAIR_CAPABILITY not in item["capabilities"]
                                 for item in selected + processes)
    if int(state.get("mapping_repair_binding_count", "0")) > 0 and mapping_repair_missing:
        reasons.add("mapping_repair_binding_requires_compatible_artifacts")
    if int(state.get("mapping_repair_unsupported_count", "0")) > 0:
        reasons.add("mapping_repair_engine_unsupported")
    launch_allowed = not reasons
    confirmation_reasons = set(reasons)
    if not state["schema_present"]:
        confirmation_reasons.add("workspace_schema_missing")
    if not inventory["pre_010c_retired"]:
        confirmation_reasons.add("retirement_required")
    if candidate_gates != {GATE} or LEGACY in active_gates:
        confirmation_reasons.add("confirmation_requires_compatible_artifacts")

    metadata_reasons = set(confirmation_reasons)
    if any(item["role"] in {"api", "worker"}
           and METADATA_CAPABILITY not in item["capabilities"]
           for item in selected + processes):
        metadata_reasons.add("metadata_capability_missing")

    activity_reasons = set(confirmation_reasons)
    if activity_missing:
        activity_reasons.add("activity_capability_missing")
    if not state.get("activity_schema_present", False):
        activity_reasons.add("activity_schema_missing")
    history_reasons = set(confirmation_reasons)
    if history_missing:
        history_reasons.add("history_capture_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        history_reasons.add("history_capture_candidate_missing")
    if not state.get("history_capture_schema_present", False):
        history_reasons.add("history_capture_schema_missing")
    timeline_reasons = set(confirmation_reasons)
    if timeline_missing:
        timeline_reasons.add("history_timeline_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        timeline_reasons.add("history_timeline_candidate_missing")
    if not state.get("history_timeline_schema_present", False):
        timeline_reasons.add("history_timeline_schema_missing")
    core_change_reasons = set(confirmation_reasons)
    if core_change_missing:
        core_change_reasons.add("core_change_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        core_change_reasons.add("core_change_candidate_missing")
    if not state.get("core_change_schema_present", False):
        core_change_reasons.add("core_change_schema_missing")
    people_refresh_reasons = set(confirmation_reasons)
    if people_refresh_missing:
        people_refresh_reasons.add("people_refresh_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        people_refresh_reasons.add("people_refresh_candidate_missing")
    if not state.get("people_refresh_schema_present", False):
        people_refresh_reasons.add("people_refresh_schema_missing")
    people_admission_reasons = set(confirmation_reasons)
    if people_admission_missing:
        people_admission_reasons.add("people_admission_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        people_admission_reasons.add("people_admission_candidate_missing")
    if not state.get("people_admission_schema_present", False):
        people_admission_reasons.add("people_admission_schema_missing")
    admitted_people_refresh_reasons = set(confirmation_reasons)
    if admitted_people_refresh_missing:
        admitted_people_refresh_reasons.add("admitted_people_refresh_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        admitted_people_refresh_reasons.add("admitted_people_refresh_candidate_missing")
    if not state.get("admitted_people_refresh_schema_present", False):
        admitted_people_refresh_reasons.add("admitted_people_refresh_schema_missing")
    admitted_metadata_reasons = set(confirmation_reasons)
    if admitted_metadata_missing:
        admitted_metadata_reasons.add("admitted_metadata_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        admitted_metadata_reasons.add("admitted_metadata_candidate_missing")
    if not state.get("admitted_metadata_schema_present", False):
        admitted_metadata_reasons.add("admitted_metadata_schema_missing")
    admitted_activity_reasons = set(confirmation_reasons)
    if admitted_activity_missing:
        admitted_activity_reasons.add("admitted_activity_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        admitted_activity_reasons.add("admitted_activity_candidate_missing")
    if not state.get("admitted_activity_schema_present", False):
        admitted_activity_reasons.add("admitted_activity_schema_missing")
    admitted_history_reasons = set(confirmation_reasons)
    if admitted_history_missing:
        admitted_history_reasons.add("admitted_history_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        admitted_history_reasons.add("admitted_history_candidate_missing")
    if not state.get("admitted_history_schema_present", False):
        admitted_history_reasons.add("admitted_history_schema_missing")
    mapping_repair_reasons = set(confirmation_reasons)
    if mapping_repair_missing:
        mapping_repair_reasons.add("mapping_repair_capability_missing")
    if not any(item["role"] in {"api", "worker"} for item in selected):
        mapping_repair_reasons.add("mapping_repair_candidate_missing")
    if not state.get("mapping_repair_schema_present", False):
        mapping_repair_reasons.add("mapping_repair_schema_missing")
    return {
        "version": 1,
        "gate_version": GATE,
        "target": target,
        "checked_at": utc_text(now),
        "evidence_expires_at": utc_text(observed + dt.timedelta(seconds=MAX_AGE_SECONDS)),
        "database_name": state["database_name"],
        "binding_count": state["binding_count"],
        "required_gate_versions": sorted(state["gate_versions"]),
        "process_count": str(len(process_ids)),
        "pre_010c_retired": inventory["pre_010c_retired"],
        "candidates": selected,
        "processes": processes,
        "launch_allowed": launch_allowed,
        "confirmation_ready": not confirmation_reasons,
        "metadata_confirmation_ready": not metadata_reasons,
        "activity_confirmation_ready": not activity_reasons,
        "activity_binding_count": state.get("activity_binding_count", "0"),
        "history_capture_confirmation_ready": not history_reasons,
        "history_capture_schema_present": state.get("history_capture_schema_present", False),
        "history_capture_binding_count": state.get("history_capture_binding_count", "0"),
        "history_capture_unsupported_count": state.get("history_capture_unsupported_count", "0"),
        "history_timeline_confirmation_ready": not timeline_reasons,
        "history_timeline_schema_present": state.get("history_timeline_schema_present", False),
        "history_timeline_binding_count": state.get("history_timeline_binding_count", "0"),
        "history_timeline_unsupported_count": state.get("history_timeline_unsupported_count", "0"),
        "core_change_confirmation_ready": not core_change_reasons,
        "core_change_schema_present": state.get("core_change_schema_present", False),
        "core_change_binding_count": state.get("core_change_binding_count", "0"),
        "core_change_unsupported_count": state.get("core_change_unsupported_count", "0"),
        "people_refresh_confirmation_ready": not people_refresh_reasons,
        "people_refresh_schema_present": state.get("people_refresh_schema_present", False),
        "people_refresh_binding_count": state.get("people_refresh_binding_count", "0"),
        "people_refresh_unsupported_count": state.get("people_refresh_unsupported_count", "0"),
        "people_admission_confirmation_ready": not people_admission_reasons,
        "people_admission_schema_present": state.get("people_admission_schema_present", False),
        "people_admission_binding_count": state.get("people_admission_binding_count", "0"),
        "people_admission_unsupported_count": state.get("people_admission_unsupported_count", "0"),
        "admitted_people_refresh_confirmation_ready": not admitted_people_refresh_reasons,
        "admitted_people_refresh_schema_present": state.get("admitted_people_refresh_schema_present", False),
        "admitted_people_refresh_binding_count": state.get("admitted_people_refresh_binding_count", "0"),
        "admitted_people_refresh_unsupported_count": state.get("admitted_people_refresh_unsupported_count", "0"),
        "admitted_metadata_confirmation_ready": not admitted_metadata_reasons,
        "admitted_metadata_schema_present": state.get("admitted_metadata_schema_present", False),
        "admitted_metadata_binding_count": state.get("admitted_metadata_binding_count", "0"),
        "admitted_metadata_unsupported_count": state.get("admitted_metadata_unsupported_count", "0"),
        "admitted_activity_confirmation_ready": not admitted_activity_reasons,
        "admitted_activity_schema_present": state.get("admitted_activity_schema_present", False),
        "admitted_activity_binding_count": state.get("admitted_activity_binding_count", "0"),
        "admitted_activity_unsupported_count": state.get("admitted_activity_unsupported_count", "0"),
        "admitted_history_confirmation_ready": not admitted_history_reasons,
        "mapping_repair_confirmation_ready": not mapping_repair_reasons,
        "admitted_history_schema_present": state.get("admitted_history_schema_present", False),
        "mapping_repair_schema_present": state.get("mapping_repair_schema_present", False),
        "admitted_history_binding_count": state.get("admitted_history_binding_count", "0"),
        "mapping_repair_binding_count": state.get("mapping_repair_binding_count", "0"),
        "admitted_history_unsupported_count": state.get("admitted_history_unsupported_count", "0"),
        "mapping_repair_unsupported_count": state.get("mapping_repair_unsupported_count", "0"),
        "launch_reasons": sorted(reasons),
        "confirmation_reasons": sorted(confirmation_reasons),
        "metadata_confirmation_reasons": sorted(metadata_reasons),
        "activity_confirmation_reasons": sorted(activity_reasons),
        "history_capture_confirmation_reasons": sorted(history_reasons),
        "history_timeline_confirmation_reasons": sorted(timeline_reasons),
        "core_change_confirmation_reasons": sorted(core_change_reasons),
        "people_refresh_confirmation_reasons": sorted(people_refresh_reasons),
        "people_admission_confirmation_reasons": sorted(people_admission_reasons),
        "admitted_metadata_confirmation_reasons": sorted(admitted_metadata_reasons),
        "admitted_activity_confirmation_reasons": sorted(admitted_activity_reasons),
        "admitted_history_confirmation_reasons": sorted(admitted_history_reasons),
        "mapping_repair_confirmation_reasons": sorted(mapping_repair_reasons),
        "admitted_people_refresh_confirmation_reasons": sorted(admitted_people_refresh_reasons),
    }


def unique_object(pairs):
    output = {}
    for key, value in pairs:
        if key in output:
            fail()
        output[key] = value
    return output


def decode_json(raw):
    if len(raw) > MAX_JSON_BYTES:
        fail()
    try:
        return json.loads(raw, object_pairs_hook=unique_object,
                          parse_constant=lambda _value: fail())
    except (ValueError, UnicodeError, RecursionError):
        fail()


def operator_file(path):
    try:
        with open(path, "rb") as source:
            info = os.fstat(source.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid not in {0, os.geteuid()}
                    or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
                fail("operator_file_permissions")
            raw = source.read(MAX_JSON_BYTES + 1)
    except OSError:
        fail("operator_file_unavailable")
    return decode_json(raw), hashlib.sha256(raw).hexdigest()


def hash_candidates(document):
    output = []
    for item in versioned(document, "artifacts"):
        object_fields(item, {"role", "path"})
        if (not valid_role(item["role"]) or not isinstance(item["path"], str)
                or not item["path"] or "\0" in item["path"]):
            fail()
        digest = hashlib.sha256()
        try:
            with open(Path(item["path"]), "rb") as source:
                before = os.fstat(source.fileno())
                if (not stat.S_ISREG(before.st_mode) or before.st_uid not in {0, os.geteuid()}
                        or before.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
                    fail("candidate_file_permissions")
                for chunk in iter(lambda: source.read(1024 * 1024), b""):
                    digest.update(chunk)
                after = os.fstat(source.fileno())
                if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
                        after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                    fail("candidate_changed")
        except OSError:
            fail("candidate_unavailable")
        output.append({"role": item["role"], "sha256": digest.hexdigest()})
    return {"version": 1, "artifacts": output}


def sql_json(sql):
    try:
        result = subprocess.run(
            ["psql", "-X", "--no-password", "-qAt", "-v", "ON_ERROR_STOP=1", "-c", sql],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=15, check=False,
            env={**os.environ, "PGCONNECT_TIMEOUT": "5", "PGOPTIONS": "-c default_transaction_read_only=on -c statement_timeout=5000"},
        )
    except (OSError, subprocess.TimeoutExpired):
        fail("database_unavailable")
    if result.returncode != 0:
        fail("database_unavailable")
    try:
        return decode_json(result.stdout)
    except EvidenceError:
        fail("database_evidence_invalid")


def database_state():
    schema = sql_json("SELECT json_build_object('present',to_regclass('public.migration_workspace') IS NOT NULL,'database_name',current_database())")
    object_fields(schema, {"present", "database_name"})
    if type(schema["present"]) is not bool:
        fail("database_evidence_invalid")
    if not schema["present"]:
        return {"schema_present": False, "binding_count": "0", "gate_versions": [],
                "database_name": schema["database_name"]}
    # Deliberately no run-state filter: cancelled/completed bindings still hold.
    state = sql_json("SELECT json_build_object('schema_present',true,'binding_count',count(*)::text,'gate_versions',COALESCE(json_agg(DISTINCT gate_version),'[]'::json),'database_name',current_database()) FROM public.migration_workspace")
    activity = sql_json("SELECT json_build_object('present',to_regclass('public.migration_activity_import') IS NOT NULL)")
    object_fields(activity, {"present"})
    if type(activity["present"]) is not bool:
        fail("database_evidence_invalid")
    state["activity_schema_present"] = activity["present"]
    state["activity_binding_count"] = "0"
    if activity["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text) FROM public.migration_activity_import WHERE confirmed_plan_id IS NOT NULL")
        object_fields(observed, {"count"})
        state["activity_binding_count"] = observed["count"]
    history = sql_json("SELECT json_build_object('present',to_regclass('public.migration_history_capture_run') IS NOT NULL)")
    object_fields(history, {"present"})
    if type(history["present"]) is not bool:
        fail("database_evidence_invalid")
    state["history_capture_schema_present"] = history["present"]
    state["history_capture_binding_count"] = "0"
    state["history_capture_unsupported_count"] = "0"
    if history["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text,'unsupported_count',count(*) FILTER (WHERE profile_version<>'fub-history-v1' OR parser_version<>'1')::text) FROM public.migration_history_capture_run WHERE confirmed_at IS NOT NULL")
        object_fields(observed, {"count", "unsupported_count"})
        state["history_capture_binding_count"] = observed["count"]
        state["history_capture_unsupported_count"] = observed["unsupported_count"]
    timeline = sql_json("SELECT json_build_object('present',to_regclass('public.migration_history_import_anchor') IS NOT NULL)")
    object_fields(timeline, {"present"})
    if type(timeline["present"]) is not bool:
        fail("database_evidence_invalid")
    state["history_timeline_schema_present"] = timeline["present"]
    state["history_timeline_binding_count"] = "0"
    state["history_timeline_unsupported_count"] = "0"
    if timeline["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text,'unsupported_count',count(*) FILTER (WHERE interpretation_version<>'fub-history-interpretation-v1' OR reader_version<>'fub-history-timeline-v1')::text) FROM public.migration_history_import_anchor")
        object_fields(observed, {"count", "unsupported_count"})
        state["history_timeline_binding_count"] = observed["count"]
        state["history_timeline_unsupported_count"] = observed["unsupported_count"]
    core_change = sql_json("SELECT json_build_object('present',to_regclass('public.migration_core_change_report') IS NOT NULL)")
    object_fields(core_change, {"present"})
    if type(core_change["present"]) is not bool:
        fail("database_evidence_invalid")
    state["core_change_schema_present"] = core_change["present"]
    state["core_change_binding_count"] = "0"
    state["core_change_unsupported_count"] = "0"
    if core_change["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text,'unsupported_count',count(*) FILTER (WHERE engine_version<>'fub-core-change-v1')::text) FROM public.migration_core_change_report")
        object_fields(observed, {"count", "unsupported_count"})
        state["core_change_binding_count"] = observed["count"]
        state["core_change_unsupported_count"] = observed["unsupported_count"]
    people_refresh = sql_json("SELECT json_build_object('present',(SELECT bool_or(to_regclass('public.'||name) IS NOT NULL) FROM (VALUES ('migration_people_refresh'),('migration_people_refresh_plan'),('migration_people_refresh_item'),('migration_people_refresh_contact'),('migration_people_refresh_result'),('migration_people_refresh_baseline'),('migration_people_refresh_receipt'),('migration_people_refresh_reservation')) required(name)),'compatible',(SELECT bool_and(to_regclass('public.'||name) IS NOT NULL) FROM (VALUES ('migration_people_refresh'),('migration_people_refresh_plan'),('migration_people_refresh_item'),('migration_people_refresh_contact'),('migration_people_refresh_result'),('migration_people_refresh_baseline'),('migration_people_refresh_receipt'),('migration_people_refresh_reservation')) required(name)) AND to_regprocedure('public.crm_people_refresh_mutation_allowed(uuid,text,text,text,jsonb)') IS NOT NULL AND EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_people_refresh') AND attname='confirmed_refresh_plan_id' AND atttypid='uuid'::regtype AND NOT attisdropped) AND EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_people_refresh_plan') AND attname='prepared_bytes' AND atttypid='bigint'::regtype AND attnotnull AND NOT attisdropped))")
    object_fields(people_refresh, {"present", "compatible"})
    if any(type(people_refresh[key]) is not bool for key in ["present", "compatible"]):
        fail("database_evidence_invalid")
    # A partially missing guard/schema is not an empty old installation.
    # Fail closed before it can hide retained bindings behind a zero count.
    if people_refresh["present"] != people_refresh["compatible"]:
        fail("people_refresh_schema_incomplete")
    state["people_refresh_schema_present"] = people_refresh["present"]
    state["people_refresh_binding_count"] = "0"
    state["people_refresh_unsupported_count"] = "0"
    if people_refresh["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text,'unsupported_count',count(*) FILTER (WHERE engine_version<>'fub-people-refresh-v1')::text) FROM public.migration_people_refresh")
        object_fields(observed, {"count", "unsupported_count"})
        state["people_refresh_binding_count"] = observed["count"]
        state["people_refresh_unsupported_count"] = observed["unsupported_count"]
    people_admission = sql_json("SELECT json_build_object('present',(SELECT bool_or(to_regclass('public.'||name) IS NOT NULL) FROM (VALUES ('migration_people_admission'),('migration_people_admission_plan'),('migration_people_admission_item'),('migration_people_admission_contact'),('migration_people_admission_result'),('migration_people_admission_receipt'),('migration_people_admission_reservation'),('person_admission_provenance'),('person_admitted')) required(name)) OR to_regprocedure('public.crm_people_admission_mutation_allowed(uuid,text,text,text,jsonb)') IS NOT NULL OR to_regprocedure('public.crm_people_admission_lock_stage(uuid,uuid)') IS NOT NULL OR EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_import_identity') AND attname IN ('admission_id','admission_item_id','admission_result_id') AND NOT attisdropped),'compatible',(SELECT bool_and(to_regclass('public.'||name) IS NOT NULL) FROM (VALUES ('migration_people_admission'),('migration_people_admission_plan'),('migration_people_admission_item'),('migration_people_admission_contact'),('migration_people_admission_result'),('migration_people_admission_receipt'),('migration_people_admission_reservation'),('person_admission_provenance'),('person_admitted')) required(name)) AND to_regprocedure('public.crm_people_admission_mutation_allowed(uuid,text,text,text,jsonb)') IS NOT NULL AND to_regprocedure('public.crm_people_admission_lock_stage(uuid,uuid)') IS NOT NULL AND EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_people_admission') AND attname='confirmed_admission_plan_id' AND atttypid='uuid'::regtype AND NOT attisdropped) AND EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_people_admission_plan') AND attname='prepared_bytes' AND atttypid='bigint'::regtype AND attnotnull AND NOT attisdropped) AND (SELECT count(*)=3 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_import_identity') AND attname IN ('admission_id','admission_item_id','admission_result_id') AND atttypid='uuid'::regtype AND NOT attisdropped))")
    object_fields(people_admission, {"present", "compatible"})
    if any(type(people_admission[key]) is not bool for key in ["present", "compatible"]):
        fail("database_evidence_invalid")
    # A partially missing guard/schema is not an empty old installation.
    # Fail closed before it can hide retained bindings behind a zero count.
    if people_admission["present"] != people_admission["compatible"]:
        fail("people_admission_schema_incomplete")
    state["people_admission_schema_present"] = people_admission["present"]
    state["people_admission_binding_count"] = "0"
    state["people_admission_unsupported_count"] = "0"
    if people_admission["present"]:
        observed = sql_json("SELECT json_build_object('count',count(*)::text,'unsupported_count',count(*) FILTER (WHERE engine_version<>'fub-people-admission-v1')::text) FROM public.migration_people_admission")
        object_fields(observed, {"count", "unsupported_count"})
        state["people_admission_binding_count"] = observed["count"]
        state["people_admission_unsupported_count"] = observed["unsupported_count"]
    admitted_people_refresh = sql_json("SELECT json_build_object('present',((SELECT bool_or(to_regclass('public.'||name) IS NOT NULL) FROM (VALUES ('migration_admitted_people_refresh'),('migration_admitted_people_refresh_plan'),('migration_admitted_people_refresh_item'),('migration_admitted_people_refresh_contact'),('migration_admitted_people_refresh_result'),('migration_admitted_people_refresh_baseline'),('migration_admitted_people_refresh_receipt'),('migration_admitted_people_refresh_reservation'),('person_admitted_refresh_provenance')) required(name)) OR to_regprocedure('public.crm_admitted_people_refresh_mutation_allowed(uuid,text,text,text,jsonb,jsonb)') IS NOT NULL),'compatible',((SELECT bool_and(to_regclass('public.'||name) IS NOT NULL) FROM (VALUES ('migration_admitted_people_refresh'),('migration_admitted_people_refresh_plan'),('migration_admitted_people_refresh_item'),('migration_admitted_people_refresh_contact'),('migration_admitted_people_refresh_result'),('migration_admitted_people_refresh_baseline'),('migration_admitted_people_refresh_receipt'),('migration_admitted_people_refresh_reservation'),('person_admitted_refresh_provenance')) required(name)) AND to_regprocedure('public.crm_admitted_people_refresh_mutation_allowed(uuid,text,text,text,jsonb,jsonb)') IS NOT NULL AND EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_admitted_people_refresh_item') AND attname='baseline_version' AND atttypid='bigint'::regtype AND attnotnull AND NOT attisdropped) AND (SELECT count(*)=3 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_admitted_people_refresh_item') AND attname IN ('stage_mapping_id','assignee_mapping_id','baseline_result_id') AND atttypid='uuid'::regtype AND NOT attnotnull AND NOT attisdropped) AND EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid=to_regclass('public.migration_admitted_people_refresh_item') AND attname='source_account_id' AND atttypid='bigint'::regtype AND NOT attnotnull AND NOT attisdropped) AN