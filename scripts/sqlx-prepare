#!/usr/bin/env bash
# Writes backend/.sqlx/ (the offline sqlx query cache for query!/query_as!)
# against a throwaway, freshly-migrated database — never the dev database
# (docs/specs/SLICE_002.md §11). Run this after adding or changing any
# query!/query_as! macro call, then commit backend/.sqlx/.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
env_file="$repo_root/.env"

if [ ! -f "$env_file" ]; then
  echo ".env not found at repo root. Copy .env.example to .env and fill in values first." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

if [ -z "${MIGRATION_DATABASE_URL:-}" ]; then
  echo "MIGRATION_DATABASE_URL is not set in .env" >&2
  exit 1
fi

# sqlx-cli is pinned to the workspace's locked sqlx minor version: a
# mismatched CLI can write a cache in a format the build's sqlx-macros
# cannot read (docs/specs/SLICE_002.md §11).
locked_minor="$(grep -A2 '^name = "sqlx"$' "$repo_root/backend/Cargo.lock" | grep '^version' | head -1 | sed -E 's/.*"([0-9]+\.[0-9]+)\.[0-9]+".*/\1/')"
if [ -z "$locked_minor" ]; then
  echo "could not determine the locked sqlx minor version from backend/Cargo.lock" >&2
  exit 1
fi

install_hint() {
  echo "  cargo install sqlx-cli --version ${locked_minor}.6 --locked --no-default-features --features postgres,rustls" >&2
}

if ! cargo sqlx --version >/dev/null 2>&1; then
  echo "sqlx-cli is required. Install the pinned version:" >&2
  install_hint
  exit 1
fi

cli_version="$(cargo sqlx --version 2>&1 | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
cli_minor="${cli_version%.*}"
if [ "$cli_minor" != "$locked_minor" ]; then
  echo "sqlx-cli ${cli_version} does not match the workspace's locked sqlx ${locked_minor}.x." >&2
  echo "Install the pinned version:" >&2
  install_hint
  exit 1
fi

# A throwaway database, never the dev database.
prepare_url="${MIGRATION_DATABASE_URL%/*}/crm_sqlx_prepare"

cleanup() {
  (cd "$repo_root/backend" && cargo sqlx database drop -y --database-url "$prepare_url" >/dev/null 2>&1) || true
}
trap cleanup EXIT

cd "$repo_root/backend"

echo "==> creating throwaway database"
cargo sqlx database create --database-url "$prepare_url"

echo "==> applying migrations (CLI migrator; no compilation required)"
cargo sqlx migrate run --source crates/crm-api/migrations --database-url "$prepare_url"

echo "==> preparing offline query cache (backend/.sqlx/)"
# Shares the main target dir (unlike scripts/check-db's isolated one) because
# this only runs when queries actually changed, so the SQLX_OFFLINE=false
# fingerprint clobber it causes forces a relink that was already justified.
DATABASE_URL="$prepare_url" SQLX_OFFLINE=false cargo sqlx prepare --workspace

echo "==> sqlx-prepare complete"
